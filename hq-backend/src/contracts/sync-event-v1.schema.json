{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fnb-platform/schemas/sync-event-v1.schema.json",
  "title": "Outlet-to-HQ synchronization event envelope (v1)",
  "description": "Versioned contract for events pushed by an outlet worker to the HQ inbox (PRD §8.4). Events are immutable; identity is (outletId, eventId) and (outletId, sequenceNo). Money values are canonical decimal strings of integer minor units bounded to PostgreSQL bigint. Integrity invariants: quantity * unitPriceMinor = subtotalMinor; sum(subtotalMinor) = totalMinor. This file is duplicated intentionally in hq-backend and outlet-backend (independent deployments, PRD §2) and must be kept identical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "outletId",
    "sequenceNo",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Immutable event ID; equals the outbox row ID at the outlet."
    },
    "eventType": {
      "type": "string",
      "enum": ["sale.completed"],
      "description": "Discriminator. New event types are additive changes; unknown required versions must be quarantined, not ignored."
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "outletId": {
      "type": "string",
      "format": "uuid",
      "description": "Must match the outlet bound to the authenticated machine key."
    },
    "sequenceNo": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})$",
      "description": "Per-outlet contiguous sequence allocated in the same local transaction as the outbox row."
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saleId",
        "receiptNo",
        "catalogRevision",
        "currencyCode",
        "status",
        "soldAt",
        "totalMinor",
        "items"
      ],
      "properties": {
        "saleId": { "type": "string", "format": "uuid" },
        "receiptNo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+-[0-9]{1,19}$",
          "description": "Outlet-scoped display receipt, e.g. A-000001."
        },
        "catalogRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})$",
          "description": "Local catalog revision the sale was priced against."
        },
        "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "status": { "type": "string", "enum": ["COMPLETED"] },
        "soldAt": { "type": "string", "format": "date-time" },
        "totalMinor": { "$ref": "#/$defs/moneyMinor" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "saleItemId",
              "menuItemId",
              "nameSnapshot",
              "skuSnapshot",
              "quantity",
              "unitPriceMinor",
              "subtotalMinor"
            ],
            "properties": {
              "saleItemId": { "type": "string", "format": "uuid" },
              "menuItemId": { "type": "string", "format": "uuid" },
              "nameSnapshot": { "type": "string", "minLength": 1, "maxLength": 255 },
              "skuSnapshot": { "type": "string", "minLength": 1, "maxLength": 64 },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
              "unitPriceMinor": { "$ref": "#/$defs/moneyMinor" },
              "subtotalMinor": { "$ref": "#/$defs/moneyMinor" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "moneyMinor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})$",
      "description": "Nonnegative integer minor units as a canonical decimal string (fits PostgreSQL bigint)."
    }
  }
}
