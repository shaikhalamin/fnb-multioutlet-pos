# hq-backend — local development environment (placeholders only).
# Copy to .env for non-Docker development; Compose injects its own values.
# For personal overrides copy to .env.local (wins over .env; real environment
# variables always win over both). Never commit real secrets.
#
# Both entrypoints (pnpm start:dev / pnpm start:worker) share this file; the
# API entrypoint requires the auth secrets below, the worker does not.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches the root docker-compose.yml hq-db service (published on localhost).
DATABASE_URL=postgresql://fnb_hq:fnb_hq_dev_password@localhost:15432/fnb_hq
REDIS_URL=redis://localhost:16379

HQ_JWT_ISSUER=fnb-hq
HQ_JWT_AUDIENCE=fnb-hq-api
HQ_JWT_PRIVATE_KEY=replace-with-private-key
HQ_JWT_PUBLIC_KEY=replace-with-public-key
OUTLET_KEY_PEPPER=replace-with-random-pepper

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
SYNC_MAX_BODY_BYTES=1048576

CORS_ORIGINS=http://localhost:8080
SWAGGER_ENABLED=true

# ---- Worker entrypoint only (no API auth secrets required) ------------------
HEARTBEAT_INTERVAL_MS=60000
