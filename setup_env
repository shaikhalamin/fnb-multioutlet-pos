#!/usr/bin/env bash
# =============================================================================
# setup_env — bootstrap the local Compose cluster.
# Copy each .env.example to .env, build the images, start the stack
# (migrations run automatically), then seed HQ and Outlet A.
# Manual equivalent: README "Fresh clone → running system", steps 1-5.
# =============================================================================
set -euo pipefail
cd "$(dirname "$0")"

echo "==> Creating .env files (existing ones are kept)"
for env in .env hq-backend/.env outlet-backend/.env hq-frontend/.env outlet-frontend/.env; do
  [ -f "$env" ] || cp "${env}.example" "$env"
done

echo "==> Building images"
docker compose build

echo "==> Starting stack (hq-migrate / outlet-a-migrate run before the APIs)"
docker compose up -d

echo "==> Seeding HQ (admin + demo outlets/items)"
docker compose run --rm -T hq-api node dist/database/seed.js

echo "==> Seeding Outlet A (POS users + demo catalog)"
docker compose run --rm -T outlet-a-api node dist/database/seed.js

cat <<'EOF'

Setup complete.
  HQ console:   http://localhost:8080  (admin@fnb.local / Admin123!)
  Outlet A POS: http://localhost:8081  (manager@outlet-a.local / Manager123!)
  HQ API:       http://localhost:4000/api/v1  (Swagger: /api/v1/docs)
  Outlet A API: http://localhost:5000/api/v1  (Swagger: /api/v1/docs)

To enable outlet -> HQ sync (optional — POS sales work without it), issue
the outlet machine key, paste it into .env, and restart the worker:
  docker compose run --rm -e SEED_ISSUE_OUTLET_KEYS=1 hq-api node dist/database/seed.js
  # copy the printed outlet-A keyId/secret into .env:
  #   OUTLET_A_HQ_KEY_ID=<keyId>
  #   OUTLET_A_HQ_KEY_SECRET=<secret>
  docker compose up -d outlet-a-worker
EOF
