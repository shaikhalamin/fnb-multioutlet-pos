# =============================================================================
# fnb-platform — central Compose environment (placeholders only)
# Copy to .env for local development and replace all secrets.
# Never commit the real .env. Never bake these values into images.
# =============================================================================

# ---- Ports published to the host ------------------------------------------
HQ_API_PORT=4000
HQ_WEB_PORT=8080
OUTLET_A_API_PORT=5000
OUTLET_A_WEB_PORT=8081

# ---- HQ PostgreSQL ----------------------------------------------------------
HQ_POSTGRES_USER=fnb_hq
HQ_POSTGRES_PASSWORD=change-me-hq-db-password
HQ_POSTGRES_DB=fnb_hq

# ---- Outlet A PostgreSQL ----------------------------------------------------
OUTLET_A_POSTGRES_USER=fnb_outlet_a
OUTLET_A_POSTGRES_PASSWORD=change-me-outlet-a-db-password
OUTLET_A_POSTGRES_DB=fnb_outlet_a

# ---- Outlet A identity (provisioned at HQ; immutable locally) ---------------
OUTLET_A_ID=11111111-1111-4111-8111-111111111111
OUTLET_A_CODE=A

# ---- Outlet A machine key issued by HQ (PRD §9.2) ---------------------------
# Dev provisioning loop (outlets sync with HQ only after this; see README
# "Fresh clone → running system", steps 3–4):
#   1. docker compose run --rm -e SEED_ISSUE_OUTLET_KEYS=1 hq-api \
#        node dist/database/seed.js
#      → prints one-time `keyId` + `secret` per seeded outlet
#   2. Paste the pair below, then `docker compose up -d outlet-a-worker`
OUTLET_A_HQ_KEY_ID=replace-with-real-key-id
OUTLET_A_HQ_KEY_SECRET=replace-with-real-key-secret

# ---- HQ auth (PRD §14.1) ----------------------------------------------------
# Symmetric HMAC secrets the HQ API validates (JWT_ACCESS_SECRET /
# JWT_REFRESH_SECRET); compose ships dev-only fallbacks, production must set
# real values (min 32 chars each).
HQ_JWT_ISSUER=fnb-hq
HQ_JWT_AUDIENCE=fnb-hq-api
JWT_ACCESS_SECRET=replace-with-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-random-32-plus-char-secret
OUTLET_KEY_PEPPER=replace-with-random-pepper
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Rotation overlap window for outlet API keys in hours (PRD §9.2).
KEY_ROTATION_GRACE_HOURS=24

# ---- Outlet auth ------------------------------------------------------------
# Symmetric HMAC secrets the outlet API validates (OUTLET_JWT_ACCESS_SECRET /
# OUTLET_JWT_REFRESH_SECRET, distinct from the HQ pair); compose ships
# dev-only fallbacks, production must set real values (min 32 chars each).
OUTLET_JWT_ISSUER=fnb-outlet
OUTLET_JWT_AUDIENCE=fnb-outlet-api
OUTLET_JWT_ACCESS_SECRET=replace-with-random-32-plus-char-secret
OUTLET_JWT_REFRESH_SECRET=replace-with-random-32-plus-char-secret

# ---- Outlet A API throttle (perf runs; PRD §16) -----------------------------
# Global per-IP throttle budget for the outlet POS API. Raise the limit for
# `pnpm perf:sale` runs through these knobs instead of code changes.
OUTLET_A_THROTTLE_TTL_MS=60000
OUTLET_A_THROTTLE_LIMIT=100

# ---- Shared operational knobs ----------------------------------------------
LOG_LEVEL=info
OFFLINE_GRACE_HOURS=72
