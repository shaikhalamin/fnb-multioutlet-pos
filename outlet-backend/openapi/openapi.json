              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OutletMenuItemResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Active local menu with effective prices and stock.",
        "tags": [
          "Menu"
        ]
      }
    },
    "/inventory": {
      "get": {
        "operationId": "InventoryController_listBalances",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InventoryBalanceResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Local stock balances joined with catalog identity.",
        "tags": [
          "Inventory"
        ]
      }
    },
    "/inventory/adjustments": {
      "post": {
        "operationId": "InventoryController_adjust",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustInventoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdjustInventoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "UNPROCESSABLE_ENTITY / ITEM_NOT_ASSIGNED / INSUFFICIENT_STOCK"
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Audited stock adjustment (RESTOCK / WRITE_OFF / RECOUNT).",
        "tags": [
          "Inventory"
        ]
      }
    },
    "/sales": {
      "post": {
        "operationId": "SalesController_createSale",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSaleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaleResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED — missing/invalid Idempotency-Key or body"
          },
          "409": {
            "description": "INSUFFICIENT_STOCK / IDEMPOTENCY_KEY_REUSED"
          },
          "422": {
            "description": "ITEM_NOT_ASSIGNED / ITEM_INACTIVE"
          },
          "503": {
            "description": "SYNC_TEMPORARILY_UNAVAILABLE — offline grace expired"
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Create an atomic multi-item sale (requires an Idempotency-Key header).",
        "tags": [
          "Sales"
        ]
      },
      "get": {
        "operationId": "SalesController_listSales",
        "parameters": [
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Inclusive lower bound on soldAt (ISO 8601 UTC).",
            "schema": {
              "example": "2026-11-01T00:00:00.000Z",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Inclusive upper bound on soldAt (ISO 8601 UTC).",
            "schema": {
              "example": "2026-11-30T23:59:59.999Z",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 200,
              "default": 50,
              "example": 50,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from meta.nextCursor.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SaleSummaryResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Local sale history (keyset pagination, optional from/to).",
        "tags": [
          "Sales"
        ]
      }
    },
    "/sales/{id}": {
      "get": {
        "operationId": "SalesController_getSale",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaleResponse"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND"
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Receipt detail with immutable line snapshots and sync status.",
        "tags": [
          "Sales"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness/readiness probe (database + Redis)",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "F&B Platform — Outlet API",
    "description": "Outlet POS API for the locally assigned catalog, inventory, atomic multi-item sales and receipts. Runs at the outlet site against its own PostgreSQL; sales never depend on HQ reachability. All responses use the `ApiSuccess`/`ApiError` envelopes; money is a decimal string of integer minor units.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current deployment"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer-jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Outlet user access token (Phase 2)"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local",
            "description": "Outlet user email."
          },
          "password": {
            "type": "string",
            "example": "Cashier123!",
            "description": "Outlet user password.",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "f5df2a66-119c-45e5-b797-fd31cfd93aa8"
          },
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local"
          },
          "roleCodes": {
            "example": [
              "OUTLET_CASHIER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "example": [
              "menu.read",
              "sales.create",
              "sales.read"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outletId": {
            "type": "string",
            "example": "61de28db-92ed-46ef-9d90-3a951ac03420",
            "description": "Provisioned outlet this account belongs to."
          }
        },
        "required": [
          "id",
          "email",
          "roleCodes",
          "permissions",
          "outletId"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIs…",
            "description": "Short-lived HS256 access JWT."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 900,
            "description": "Access token lifetime in seconds."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresInSeconds",
          "user"
        ]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "f5df2a66-119c-45e5-b797-fd31cfd93aa8"
          },
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local"
          },
          "status": {
            "type": "string",
            "example": "ACTIVE",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "roleCodes": {
            "example": [
              "OUTLET_CASHIER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "example": "2026-11-20T04:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-11-20T04:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "roleCodes",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local",
            "description": "Work email; unique at this outlet."
          },
          "password": {
            "type": "string",
            "example": "StrongPass123!",
            "minLength": 8,
            "maxLength": 128
          },
          "roleCodes": {
            "example": [
              "OUTLET_CASHIER"
            ],
            "description": "Local role codes to assign.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "password",
          "roleCodes"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "DISABLED",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "roleCodes": {
            "example": [
              "OUTLET_CASHIER"
            ],
            "description": "Replaces the role set when present.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RoleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "0c9d0f0e-2fa2-4f71-a111-6e2f83d94d02"
          },
          "code": {
            "type": "string",
            "example": "OUTLET_CASHIER"
          },
          "name": {
            "type": "string",
            "example": "Outlet Cashier"
          },
          "permissions": {
            "example": [
              "menu.read",
              "sales.create",
              "sales.read"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "permissions"
        ]
      },
      "OutletMenuItemResponse": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab",
            "description": "HQ master-menu-item UUID (local catalog key)."
          },
          "sku": {
            "type": "string",
            "example": "BURGER-01"
          },
          "name": {
            "type": "string",
            "example": "Chicken Burger"
          },
          "description": {
            "type": "string",
            "example": "Grilled chicken burger"
          },
          "category": {
            "type": "string",
            "example": "Burgers"
          },
          "unitPriceMinor": {
            "type": "string",
            "example": "1200",
            "description": "Effective outlet price, integer minor units, decimal string."
          },
          "currencyCode": {
            "type": "string",
            "example": "USD"
          },
          "availableQuantity": {
            "type": "number",
            "example": 30,
            "description": "On-hand quantity; 0 when no balance row exists."
          }
        },
        "required": [
          "menuItemId",
          "sku",
          "name",
          "description",
          "category",
          "unitPriceMinor",
          "currencyCode",
          "availableQuantity"
        ]
      },
      "InventoryBalanceResponse": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab"
          },
          "name": {
            "type": "string",
            "example": "Chicken Burger"
          },
          "sku": {
            "type": "string",
            "example": "BURGER-01"
          },
          "quantityOnHand": {
            "type": "number",
            "example": 30,
            "description": "On-hand quantity (integer)."
          },
          "version": {
            "type": "number",
            "example": 4,
            "description": "Balance row version; bumps on every mutation."
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-11-20T04:00:00.000Z"
          }
        },
        "required": [
          "menuItemId",
          "name",
          "sku",
          "quantityOnHand",
          "version",
          "updatedAt"
        ]
      },
      "AdjustInventoryRequest": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab",
            "description": "Local catalog item to adjust."
          },
          "deltaQuantity": {
            "type": "number",
            "example": 50,
            "description": "Signed quantity delta applied to on-hand stock (±1,000,000)."
          },
          "reason": {
            "type": "string",
            "example": "RESTOCK",
            "enum": [
              "RESTOCK",
              "WRITE_OFF",
              "RECOUNT"
            ]
          }
        },
        "required": [
          "menuItemId",
          "deltaQuantity",
          "reason"
        ]
      },
      "AdjustInventoryResponse": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab"
          },
          "quantityOnHand": {
            "type": "number",
            "example": 80,
            "description": "On-hand quantity after the adjustment."
          },
          "version": {
            "type": "number",
            "example": 5
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-11-20T04:00:00.000Z"
          }
        },
        "required": [
          "menuItemId",
          "quantityOnHand",
          "version",
          "updatedAt"
        ]
      },
      "CreateSaleRequestLine": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab",
            "description": "Local catalog item UUID."
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 100000,
            "description": "Line quantity; duplicates are merged by menuItemId server-side."
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "CreateSaleRequest": {
        "type": "object",
        "properties": {
          "items": {
            "description": "1..100 distinct lines; duplicate menuItemIds are merged before validation.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateSaleRequestLine"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "SaleItemResponse": {
        "type": "object",
        "properties": {
          "saleItemId": {
            "type": "string",
            "example": "64750166-32a4-46f8-9285-f536f5b03213"
          },
          "menuItemId": {
            "type": "string",
            "example": "9708835e-2e21-465a-87e9-5f8d56cd44ab"
          },
          "name": {
            "type": "string",
            "example": "Chicken Burger",
            "description": "Immutable name snapshot captured at sale time (FR-02)."
          },
          "sku": {
            "type": "string",
            "example": "BURGER-01",
            "description": "Immutable SKU snapshot captured at sale time."
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unitPriceMinor": {
            "type": "string",
            "example": "1200",
            "description": "Snapshot unit price, integer minor units, decimal string."
          },
          "subtotalMinor": {
            "type": "string",
            "example": "2400",
            "description": "Line subtotal, integer minor units, decimal string."
          }
        },
        "required": [
          "saleItemId",
          "menuItemId",
          "name",
          "sku",
          "quantity",
