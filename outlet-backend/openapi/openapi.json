                    "$ref": "#/components/schemas/RoleResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "List local roles with their permission sets.",
        "tags": [
          "Users"
        ]
      }
    },
    "/menu": {
      "get": {
        "operationId": "MenuCacheController_getMenu",
        "parameters": [],
