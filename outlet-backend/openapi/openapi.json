{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED"
          },
          "401": {
            "description": "UNAUTHENTICATED"
          },
          "429": {
            "description": "RATE_LIMITED"
          }
        },
        "summary": "Sign in with email + password (rate limited).",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED"
          }
        },
        "summary": "Rotate the refresh cookie and mint a new access token.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ],
        "summary": "Revoke the current refresh session family.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness/readiness probe (database + Redis)",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "F&B Platform — Outlet API",
    "description": "Outlet POS API for the locally assigned catalog, inventory, atomic multi-item sales and receipts. Runs at the outlet site against its own PostgreSQL; sales never depend on HQ reachability. All responses use the `ApiSuccess`/`ApiError` envelopes; money is a decimal string of integer minor units.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current deployment"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer-jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Outlet user access token (Phase 2)"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local",
            "description": "Outlet user email."
          },
          "password": {
            "type": "string",
            "example": "Cashier123!",
            "description": "Outlet user password.",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "f5df2a66-119c-45e5-b797-fd31cfd93aa8"
          },
          "email": {
            "type": "string",
            "example": "cashier@outlet-a.local"
          },
          "roleCodes": {
            "example": [
              "OUTLET_CASHIER"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "example": [
              "menu.read",
              "sales.create",
              "sales.read"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outletId": {
            "type": "string",
            "example": "61de28db-92ed-46ef-9d90-3a951ac03420",
            "description": "Provisioned outlet this account belongs to."
          }
        },
        "required": [
          "id",
          "email",
          "roleCodes",
          "permissions",
          "outletId"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIs…",
            "description": "Short-lived HS256 access JWT."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 900,
            "description": "Access token lifetime in seconds."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresInSeconds",
          "user"
        ]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
}
