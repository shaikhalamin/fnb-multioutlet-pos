# outlet-backend — local development environment (placeholders only).
# Copy to .env for non-Docker development; Compose injects its own values.
# For personal overrides copy to .env.local (wins over .env; real environment
# variables always win over both). Never commit real secrets.
#
# Outlet identity and the HQ machine key are NOT environment inputs: the
# terminal provisions itself through the setup wizard (POST /setup/identity +
# POST /setup/hq-connection, PRD §8.7/§9.2) and stores the key in its own
# `hq_connection` table. The optional OUTLET_ID/OUTLET_CODE below are only
# read by the dev seed CLI for a local, UI-less development database.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Matches the root docker-compose.yml outlet-a-db service (published on localhost).
DATABASE_URL=postgresql://fnb_outlet_a:fnb_outlet_a_dev_password@localhost:15433/fnb_outlet_a
REDIS_URL=redis://localhost:16380

# Optional dev-seed identity (local development without the setup wizard).
OUTLET_ID=11111111-1111-4111-8111-111111111111
OUTLET_CODE=A

OUTLET_JWT_ISSUER=fnb-outlet
OUTLET_JWT_AUDIENCE=fnb-outlet-api
# Two independent HS256 signing secrets (min 32 chars each) — generate with:
#   openssl rand -base64 48
OUTLET_JWT_ACCESS_SECRET=replace-with-random-48-byte-secret-access
OUTLET_JWT_REFRESH_SECRET=replace-with-random-48-byte-secret-refresh

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# Refresh cookie `Secure` flag override. The local dev cluster terminates
# plain HTTP inside Compose, so it sets false; default is true in production.
REFRESH_COOKIE_SECURE=false

OFFLINE_GRACE_HOURS=72
SYNC_MAX_BODY_BYTES=1048576
# Global throttle per client IP; raise THROTTLE_LIMIT for perf runs
# (pnpm perf:sale) instead of changing code.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

CORS_ORIGINS=http://localhost:8081
SWAGGER_ENABLED=true

# ---- Worker-only (outlet-initiated sync toward HQ) -------------------------
# Cadence knobs only: the HQ base URL + machine key arrive through the setup
# wizard and live in the `hq_connection` table — never here (PRD §9.2).
MENU_PULL_INTERVAL_MS=30000
OUTBOX_BATCH_SIZE=100
OUTBOX_SWEEP_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=60000
# Checkpoint reconciliation cadence (default hourly, PRD §8.7).
SYNC_RECONCILE_INTERVAL_MS=3600000
